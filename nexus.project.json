{
  "repository": {
    "source": "https://github.com/saintiago/agentic-memory.git",
    "mainBranch": "main"
  },
  "preparation": [
    {
      "executable": "npm",
      "args": ["ci"]
    }
  ],
  "checks": [
    {
      "name": "validate",
      "command": {
        "executable": "npm",
        "args": ["run", "validate"]
      }
    }
  ],
  "taskSource": {
    "kind": "jira",
    "apiBase": "https://api.atlassian.com/ex/jira/9337c4da-7d33-4c1d-b03c-db207e537f88",
    "project": "AMEM",
    "credential": "jira",
    "selection": {
      "query": "project = AMEM AND issuetype = Task AND status in (\"Draft\", \"Requirements\", \"UX Proposal\", \"Storybook Refinement\", \"Architecture\", \"To Do\", \"In Progress\", \"In Review\")",
      "orderBy": "Rank ASC"
    },
    "fields": {
      "workspacePointer": "customfield_10175",
      "pullRequest": "customfield_10176"
    },
    "statuses": {
      "ready": "To Do",
      "inProgress": "In Progress",
      "review": "In Review",
      "done": "Done"
    },
    "ideas": {
      "selection": {
        "query": "project = AMEM AND issuetype = Task AND status in (\"Idea\", \"Idea Refinement\")",
        "orderBy": "Rank ASC"
      },
      "statuses": {
        "submitted": "Idea",
        "active": "Idea Refinement",
        "approved": "Draft",
        "waitingForFeedback": "Waiting for Feedback"
      }
    },
    "preparation": {
      "statuses": {
        "requirements": "Requirements",
        "uxProposal": "UX Proposal",
        "storybookRefinement": "Storybook Refinement",
        "architecture": "Architecture"
      }
    },
    "implementation": {
      "issueType": "Task",
      "labels": ["memory-build"],
      "status": "To Do",
      "linkType": "Relates"
    }
  },
  "delivery": {
    "repository": "saintiago/agentic-memory",
    "baseBranch": "main",
    "reviewCheck": "Nexus Lens review",
    "postMergeChecks": [],
    "completion": {
      "pollIntervalSeconds": 30,
      "waitLimitSeconds": 3600
    }
  }
}
